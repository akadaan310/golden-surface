[Unit]
Description=Golden Surface watcher: sync-convergence
After=network.target golden-relay.service
Wants=golden-relay.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/golden-surface
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/azureuser/golden-surface/watchers/watchers.py sync-convergence
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
