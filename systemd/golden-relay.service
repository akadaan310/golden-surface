[Unit]
Description=Golden Surface relay (websocket, /cmd, /state, /sessions, bus, twin) port 8490
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/golden-surface
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/azureuser/.local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/azureuser/golden-surface/relay/relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
